{
  "$defs": {
    "Accommodation": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hut, bivouac, tent, ...",
          "title": "Kind"
        },
        "altitude_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude M"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Groups the nights table, e.g. by peak on an expedition with several climbs.",
          "title": "Group"
        }
      },
      "required": [
        "date",
        "place"
      ],
      "title": "Accommodation",
      "type": "object"
    },
    "BaseCamp": {
      "additionalProperties": false,
      "description": "The base camp of a high-altitude expedition. Adds the expedition altitude chart: every day from\narrival to departure with its lowest and highest point and the altitude slept at.",
      "properties": {
        "altitude_m": {
          "title": "Altitude M",
          "type": "number"
        },
        "arrival": {
          "format": "date",
          "title": "Arrival",
          "type": "string"
        },
        "departure": {
          "format": "date",
          "title": "Departure",
          "type": "string"
        }
      },
      "required": [
        "altitude_m",
        "arrival",
        "departure"
      ],
      "title": "BaseCamp",
      "type": "object"
    },
    "Break": {
      "additionalProperties": false,
      "description": "A long daytime stop worth naming on the elevation profile, e.g. a hut.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        }
      },
      "required": [
        "date",
        "place"
      ],
      "title": "Break",
      "type": "object"
    },
    "Calibration": {
      "additionalProperties": false,
      "description": "Totals to trust over the ones computed from the GPX track.\n\nGPS altitude is noisy, so computed ascent is rarely exact. Give the figures you trust (a\nguidebook, or a service that corrects elevation) and every day's distance, ascent and\ndescent is scaled by the same factor, so tables and rows still add up.",
      "properties": {
        "distance_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km"
        },
        "ascent_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ascent M"
        },
        "descent_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If omitted, descent is scaled by the same factor as ascent.",
          "title": "Descent M"
        }
      },
      "title": "Calibration",
      "type": "object"
    },
    "Camp": {
      "additionalProperties": false,
      "description": "A camp on the route, described once (the nights themselves are ``accommodation`` entries).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "altitude_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude M"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Position, decimal degrees (shown with 6 decimals).",
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The mountain or route it belongs to; one subsection per group.",
          "title": "Group"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name"
      ],
      "title": "Camp",
      "type": "object"
    },
    "Cover": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "Path relative to the trip folder.",
          "title": "Image",
          "type": "string"
        },
        "kicker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Small line above the title.",
          "title": "Kicker"
        }
      },
      "required": [
        "image"
      ],
      "title": "Cover",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ],
          "title": "Title"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ],
          "description": "Diary text. Blank line = new paragraph; **bold**, *italic*.",
          "title": "Text"
        },
        "high_point_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest point of a day without a track, for the expedition altitude chart (e.g. an acclimatisation walk that was not recorded).",
          "title": "High Point M"
        }
      },
      "required": [
        "date",
        "title",
        "text"
      ],
      "title": "Day",
      "type": "object"
    },
    "MapSettings": {
      "additionalProperties": false,
      "properties": {
        "basemap": {
          "default": "plain",
          "description": "'tiles' puts a real map under the route: tiles are downloaded on the first build (needs network and the `[tiles]` extra) and cached in the trip folder.",
          "enum": [
            "plain",
            "tiles"
          ],
          "title": "Basemap",
          "type": "string"
        },
        "tile_source": {
          "default": "topo",
          "description": "'topo' = OpenTopoMap (contours, glaciers); 'light' = a minimal grey map.",
          "enum": [
            "topo",
            "light"
          ],
          "title": "Tile Source",
          "type": "string"
        },
        "color_by": {
          "default": "none",
          "enum": [
            "none",
            "day"
          ],
          "title": "Color By",
          "type": "string"
        },
        "label_peaks": {
          "default": true,
          "title": "Label Peaks",
          "type": "boolean"
        }
      },
      "title": "MapSettings",
      "type": "object"
    },
    "Peak": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "former_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Earlier name the peak is also known by.",
          "title": "Former Name"
        },
        "elevation_m": {
          "title": "Elevation M",
          "type": "number"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Used to find the summit time in the GPX track.",
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "time": {
          "anyOf": [
            {
              "pattern": "^\\d{2}:\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local summit time. Computed from the GPX track when lat/lon are given.",
          "title": "Time"
        },
        "grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grade of the route climbed, as the guidebook writes it, e.g. 'PD-'. Shown with the peak in the general information and the summit times.",
          "title": "Grade"
        },
        "grade_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grading system shown on the summit table's badge: Alpine, UIAA, ...",
          "title": "Grade System"
        },
        "ski_grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ski mountaineering grade of the route, as the guidebook writes it, e.g. '2.3 / E1'. Shown beside the climbing grade.",
          "title": "Ski Grade"
        },
        "ski_grade_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ski grading system shown on its badge, e.g. Toponeige.",
          "title": "Ski Grade System"
        },
        "climbers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participants (their names as under participants) who reached this summit. Leave it out when the whole team did. When some summit was not reached by everyone, the summit times get a column naming who reached each one.",
          "title": "Climbers"
        }
      },
      "required": [
        "name",
        "elevation_m"
      ],
      "title": "Peak",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "experience": {
          "description": "Notable previous ascents, one per entry.",
          "items": {
            "type": "string"
          },
          "title": "Experience",
          "type": "array"
        },
        "contact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The report author's goes in the footnote under the general table; anyone else's in parentheses after the name.",
          "title": "Contact"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short note after the name, e.g. which peaks they climbed.",
          "title": "Note"
        },
        "bio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A short bio: climbing background, earlier ascents.",
          "title": "Bio"
        },
        "leader": {
          "default": false,
          "description": "Marks the team leader in the participants row.",
          "title": "Leader",
          "type": "boolean"
        },
        "reporter": {
          "default": false,
          "description": "The person who prepared the report: starred in the participants, with their contact in a footnote.",
          "title": "Reporter",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "Person",
      "type": "object"
    },
    "Photo": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Path relative to the trip folder.",
          "title": "File",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ],
          "title": "Caption"
        },
        "size": {
          "default": "half",
          "description": "'full' = a page of its own; 'half' = two per page.",
          "enum": [
            "full",
            "half"
          ],
          "title": "Size",
          "type": "string"
        }
      },
      "required": [
        "file",
        "caption"
      ],
      "title": "Photo",
      "type": "object"
    },
    "RouteGroup": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overall grade as the guidebook writes it, e.g. 'AD+'.",
          "title": "Grade"
        },
        "grade_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grading system shown in small caps on the badge: Alpine, UIAA, Cat., ...",
          "title": "Grade System"
        },
        "ski_grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ski mountaineering grade, e.g. '2.3 / E1'; a glacier-blue badge after the grade.",
          "title": "Ski Grade"
        },
        "ski_grade_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ski grading system on its badge, e.g. Toponeige.",
          "title": "Ski Grade System"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra route facts shown beside the grade, e.g. '700 m'.",
          "title": "Note"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "RouteGroup",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "description": "One technical section of a route (a peak, a ridge, a pitch group).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "pitches": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitches"
        },
        "leader": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leader"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name"
      ],
      "title": "Section",
      "type": "object"
    },
    "TrackFile": {
      "additionalProperties": false,
      "description": "One GPX file of a trip with several. Each file gets its own route map and elevation profile,\nunless ``figures`` is false.",
      "properties": {
        "file": {
          "description": "Path relative to the trip folder.",
          "title": "File",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Heading above this track's map and profile, e.g. the peak.",
          "title": "Name"
        },
        "figures": {
          "default": true,
          "description": "False: the track counts in the tables and totals but gets no map or profile (e.g. acclimatisation walks).",
          "title": "Figures",
          "type": "boolean"
        }
      },
      "required": [
        "file"
      ],
      "title": "TrackFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "languages": {
      "default": [
        "lt"
      ],
      "description": "Languages the content is written in.",
      "items": {
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      ],
      "title": "Title"
    },
    "subtitle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtitle"
    },
    "cover": {
      "$ref": "#/$defs/Cover"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "timezone": {
      "default": "Europe/Zurich",
      "description": "IANA zone of the track's local time.",
      "title": "Timezone",
      "type": "string"
    },
    "day_cutoff_hour": {
      "default": 0,
      "description": "Hour at which a track day starts (use 3 if you start at 02:30).",
      "maximum": 12,
      "minimum": 0,
      "title": "Day Cutoff Hour",
      "type": "integer"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      ],
      "title": "Region"
    },
    "country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Climb class, e.g. 'Technical'.",
      "title": "Kind"
    },
    "kind_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Shown in parentheses after the class in the general information table only (not on the title page), e.g. 'unclassified ski tour'.",
      "title": "Kind Note"
    },
    "grade": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Overall grade of the whole trip as the guidebook writes grades, e.g. 'AD, III'. Useful when the trip combines several routes: give the grade of the hardest sections. Shown in the general information after the class, and as a pill next to the class on the title page.",
      "title": "Grade"
    },
    "grade_system": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Grading system on the title-page pill (default 'Alpine').",
      "title": "Grade System"
    },
    "ski_grade": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Overall ski mountaineering grade of the trip, e.g. '3.1 / E1': the hardest ski grade. A glacier-blue pill on the title page, and written after the grade in the general information.",
      "title": "Ski Grade"
    },
    "ski_grade_system": {
      "anyOf": [
        {
          "type": "string"
        },
